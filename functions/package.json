{
  "name": "selene-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": { "node": "22" },
  "scripts": {
    "copydata": "node scripts/copy-data.mjs",
    "build": "npm run copydata && tsc",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "serve": "npm run build && firebase emulators:start --only functions,auth,firestore,storage",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "@google/genai": "2.24.0",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
